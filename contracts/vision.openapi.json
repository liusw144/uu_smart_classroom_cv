{
  "openapi": "3.1.0",
  "info": {
    "title": "智慧课堂内部视觉服务",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/v1/detections": {
      "post": {
        "summary": "Detect",
        "operationId": "detect_internal_v1_detections_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectionEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "内部身份无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "请求字段无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "模型尚不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "推理资源正忙",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "推理执行失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/internal/v1/detections/{job}/artifact": {
      "get": {
        "summary": "Artifact",
        "operationId": "artifact_internal_v1_detections__job__artifact_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DetectionEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/InferenceResult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "DetectionEnvelope"
      },
      "DetectionRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Asset Id"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Input Sha256"
          },
          "model_version": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Model Version"
          },
          "media_kind": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO",
              "CAMERA"
            ],
            "title": "Media Kind",
            "default": "IMAGE"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "asset_id",
          "input_sha256",
          "model_version"
        ],
        "title": "DetectionRequest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "FrameResult": {
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Index"
          },
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Timestamp Ms"
          },
          "persons": {
            "items": {
              "$ref": "#/components/schemas/PersonResult"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Persons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "timestamp_ms",
          "persons"
        ],
        "title": "FrameResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceResult": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "title": "Schema Version"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "input_sha256": {
            "type": "string",
            "title": "Input Sha256"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "model_hashes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Model Hashes"
          },
          "media_kind": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO",
              "CAMERA"
            ],
            "title": "Media Kind"
          },
          "width": {
            "type": "integer",
            "maximum": 1280.0,
            "minimum": 2.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "maximum": 1280.0,
            "minimum": 2.0,
            "title": "Height"
          },
          "duration_ms": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 0.0,
            "title": "Duration Ms"
          },
          "sample_interval_ms": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 100.0,
            "title": "Sample Interval Ms"
          },
          "sampled_frames": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Sampled Frames"
          },
          "person_instances": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Person Instances"
          },
          "unique_people": {
            "type": "null",
            "title": "Unique People"
          },
          "pose_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Pose Counts"
          },
          "frames": {
            "items": {
              "$ref": "#/components/schemas/FrameResult"
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 1,
            "title": "Frames"
          },
          "artifact_sha256": {
            "type": "string",
            "title": "Artifact Sha256"
          },
          "artifact_size": {
            "type": "integer",
            "maximum": 33554432.0,
            "exclusiveMinimum": 0.0,
            "title": "Artifact Size"
          },
          "artifact_content_type": {
            "type": "string",
            "enum": [
              "image/png",
              "video/mp4"
            ],
            "title": "Artifact Content Type"
          },
          "request_digest": {
            "type": "string",
            "title": "Request Digest"
          },
          "processed_at": {
            "type": "string",
            "title": "Processed At"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          },
          "sampling_strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "STILL",
                  "FIXED_INTERVAL_WITH_TAIL",
                  "UNIFORM_FULL_SPAN"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Sampling Strategy"
          },
          "coverage_start_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Start Ms"
          },
          "coverage_end_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage End Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "job_id",
          "asset_id",
          "input_sha256",
          "model_version",
          "model_hashes",
          "media_kind",
          "width",
          "height",
          "duration_ms",
          "sample_interval_ms",
          "sampled_frames",
          "person_instances",
          "unique_people",
          "pose_counts",
          "frames",
          "artifact_sha256",
          "artifact_size",
          "artifact_content_type",
          "request_digest",
          "processed_at",
          "elapsed_ms",
          "interpretation"
        ],
        "title": "InferenceResult"
      },
      "PersonResult": {
        "properties": {
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "keypoints": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "maxItems": 17,
            "minItems": 17,
            "title": "Keypoints"
          },
          "pose_candidates": {
            "items": {
              "type": "string",
              "const": "HAND_UP_CANDIDATE"
            },
            "type": "array",
            "title": "Pose Candidates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bbox",
          "keypoints",
          "pose_candidates"
        ],
        "title": "PersonResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
