{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-smart-classroom:detection-request:v1",
  "title": "内部检测请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "asset_id", "input_sha256", "model_version"],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "asset_id": {"type": "string", "format": "uuid"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"}
  }
}
