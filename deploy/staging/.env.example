# 仅作为参数模板；正式镜像必须使用审核后的sha256摘要。
BACKEND_IMAGE=registry.example.edu/uu/backend@sha256:replace
TEACHER_IMAGE=registry.example.edu/uu/teacher@sha256:replace
ADMIN_IMAGE=registry.example.edu/uu/admin@sha256:replace
VISION_IMAGE=registry.example.edu/uu/vision@sha256:replace
# 加速模式还需要对应镜像、驱动和设备映射；当前默认候选镜像只带CPU运行时。
VISION_DEVICE=cpu
VISION_DEVICE_ID=0
VISION_CPU_THREADS=2
EDGE_IMAGE=registry.example.edu/uu/edge@sha256:replace
CONTROL_STATE=/srv/uu/control
EDGE_STATE=/srv/uu/edge
CONTROL_CERTS=/srv/uu/certs/control
VISION_CERTS=/srv/uu/certs/vision
EDGE_CERTS=/srv/uu/certs/edge
UI_CERTS=/srv/uu/certs/ui
MODELS=/srv/uu/models
SECRETS_DIR=/srv/uu/secrets
