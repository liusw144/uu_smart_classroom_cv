{
  "name": "uu-smart-classroom-frontend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:teacher": "npm run dev -w @uu/teacher",
    "dev:admin": "npm run dev -w @uu/admin",
    "build": "npm run build -w @uu/teacher && npm run build -w @uu/admin",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/local-mvp.cjs",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "1.21.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liusw144/uu_smart_classroom_cv.git"
  }
}
